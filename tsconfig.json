{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": ["bun-types"]
  },
  "include": ["assets/js/src/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "assets/js/vendor"]
}
